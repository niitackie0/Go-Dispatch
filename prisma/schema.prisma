// GO DISPATCH — courier booking, dispatch and tracking.
//
// Money is stored as an integer number of pesewas (GHS minor units), never a
// float. 5000 == GHS 50.00. All timestamps are timestamptz.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer takes the connection URL here; see prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — these mirror src/types.ts exactly.
// ---------------------------------------------------------------------------

enum PackageSize {
  small
  medium
  large
}

enum OrderStatus {
  requested
  awaiting_payment
  confirmed
  queued
  picked_up
  in_transit
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  manual
  momo
}

enum PaymentRecordStatus {
  pending
  success
  failed
}

/// Who settles the bill for a delivery.
/// Who settles the bill. Recipient is the norm: parcels are weighed at the
/// office and collected at the door, so the person receiving it is the one
/// with the final figure in front of them.
enum Payer {
  sender
  recipient
}

/// When the bill is settled: up front (gates confirmation) or at the door.
enum PaymentTiming {
  prepaid
  on_delivery
}

/// Staff roles. Capabilities are mapped in src/server/permissions.ts.
enum Role {
  /// Everything, including pricing and staff accounts.
  owner
  /// Payments, exports and revenue. No dispatch.
  finance
  /// Orders, statuses and riders. No pricing, no payment recording.
  /// The default, and therefore the least an account can hold.
  support
}

// ---------------------------------------------------------------------------
// Staff and sessions
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// Argon2id hash. Never store or log the plaintext.
  passwordHash String
  /// Least privilege by default; an owner must deliberately grant more.
  role         Role     @default(support)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sessions         Session[]
  statusChanges    StatusHistory[]
  recordedPayments Payment[]

  @@map("admin_users")
}

/// Admin sessions live here rather than in process memory, so a restart or a
/// second instance does not log everyone out.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the bearer token. The raw token is only ever sent to the client,
  /// so a database leak cannot be replayed as a login.
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// Shown in the "where am I signed in" list so a stranger's session is
  /// recognisable as one. Updated at most every few minutes, not per request.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  userAgent  String?
  ipAddress  String?

  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

/// A courier on the roster. NOT an account: riders never sign in to the
/// console. They receive a per-order link (Order.riderToken) that can drive
/// only their own parcel, which is why there is no password, no email and no
/// role here. Staff accounts are AdminUser; these are two different registers
/// of person and are deliberately not the same table.
model Rider {
  id    String @id @default(cuid())
  name  String
  /// E.164, normalised on the way in (src/phone.ts). Unique, because the phone
  /// is how a rider is actually identified -- two rows for one handset would be
  /// two capacity slots for one person.
  phone String @unique

  /// ON THE ROSTER. Set by an owner: hired, or gone/suspended. An inactive
  /// rider is never assigned work, keeps their delivery history, and can be
  /// brought back without re-typing anything.
  active Boolean @default(true)

  /// FREE RIGHT NOW. Owned by the automation pass, not by a human: it is
  /// cleared when a job is assigned and set again when the last one finishes.
  /// Distinct from `active` on purpose -- one is employment, the other is the
  /// next sixty minutes, and a single flag for both means the release rule
  /// silently un-suspends somebody who has left.
  available Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]

  /// The assignment query asks for both, in this order.
  @@index([active, available])
  @@map("riders")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

/// Optional directory of repeat senders. Orders deliberately keep their own
/// copy of the sender/recipient details: an order is a historical record of a
/// delivery, so it must not change when someone later edits their profile.
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id String @id @default(cuid())

  /// Customer-facing code, e.g. WP-4821-330. Unique is enforced here so a
  /// generation collision fails loudly and can be retried, rather than
  /// silently pointing two customers at the same parcel.
  trackingCode String @unique

  senderName   String
  senderPhone  String
  pickupAddress String
  pickupNotes   String?

  recipientName  String
  recipientPhone String
  dropoffAddress String
  dropoffNotes   String?

  /// The region this parcel is going to, from the served list in
  /// src/regions.ts. Text rather than an enum so a new region is a one-line
  /// change instead of a migration.
  destinationRegion String? @db.VarChar(64)

  /// The booking this parcel was part of. One sender can send several parcels
  /// to different regions in a single visit; each is still its own order with
  /// its own tracking code, rider and status, because they travel separately
  /// and arrive on different days.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// What the customer said it weighed. Used for the estimate only.
  /// packageWeightKg is that declared figure.
  ///
  /// actualWeightKg is what the scale said at the office, and it is what the
  /// price is built from. Null until the parcel has been weighed.
  actualWeightKg Decimal? @db.Decimal(6, 2)

  /// Set when staff weigh the parcel and fix the price. Until then priceAmount
  /// is an estimate and must be shown as one.
  priceConfirmedAt DateTime? @db.Timestamptz(3)

  packageSize        PackageSize
  packageWeightKg    Decimal     @db.Decimal(6, 2)
  packageDescription String

  scheduledPickupAt DateTime @db.Timestamptz(3)

  /// Integer pesewas. 5000 == GHS 50.00.
  priceAmount Int
  currency    String @default("GHS") @db.VarChar(3)

  status        OrderStatus   @default(requested)
  paymentStatus PaymentStatus @default(pending)
  payer         Payer         @default(sender)
  paymentTiming PaymentTiming @default(on_delivery)

  /// Opaque token backing the rider's self-service link. Generated with
  /// crypto.randomBytes, and cleared once the order reaches a terminal state
  /// so old links stop working.
  riderToken          String?   @unique
  riderTokenExpiresAt DateTime? @db.Timestamptz(3)

  riderId String?
  rider   Rider?  @relation(fields: [riderId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  payments      Payment[]
  statusHistory StatusHistory[]
  notifications Notification[]

  // Indexes chosen to match how the app actually queries:
  // the dashboard filters by status, lists newest-first, and reports on ranges.
  @@index([status])
  @@index([createdAt])
  @@index([riderId])
  @@index([status, createdAt])
  /// Public tracking matches a phone number exactly, against both ends. Without
  /// these two, every lookup by phone is a sequential scan of the whole table --
  /// invisible at three orders and the slowest thing in the product at thirty
  /// thousand. Bookings already had one; orders did not.
  @@index([senderPhone])
  @@index([recipientPhone])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

/// A single visit to the office: one sender, one pickup, and one or more
/// parcels going to different places.
///
/// The sender's details are also copied onto each order. That duplication is
/// deliberate — an order has to stay readable on the dispatch board and on a
/// rider's screen without joining back here, and a booking is a grouping, not
/// the source of truth for a parcel already on the road.
model Booking {
  id String @id @default(cuid())

  /// Shown to the sender so they can see all their parcels at once. Distinct
  /// from the per-parcel tracking codes, which are what recipients use.
  reference String @unique @db.VarChar(32)

  /// Sent by the booking form, one per filled-in form rather than per submit.
  /// The unique index is the whole mechanism: a second submit of the same form
  /// collides instead of booking the parcels twice. Nullable because bookings
  /// taken over the phone, and every booking made before this existed, have no
  /// form behind them.
  idempotencyKey String? @unique @db.VarChar(64)

  senderName  String
  senderPhone String
  pickupAddress String
  pickupNotes   String?

  scheduledPickupAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]

  @@index([senderPhone])
  @@index([createdAt])
  @@map("bookings")
}

model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Integer pesewas, matching Order.priceAmount.
  amount   Int
  currency String @default("GHS") @db.VarChar(3)

  provider PaymentProvider
  /// Provider-side transaction id. Unique so a replayed MoMo webhook cannot
  /// be recorded as a second payment.
  providerReference String? @unique

  status PaymentRecordStatus @default(pending)
  paidAt DateTime?           @db.Timestamptz(3)

  /// Set when an admin records a payment by hand.
  recordedByAdminId String?
  recordedByAdmin   AdminUser? @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

/// Append-only. Every status transition writes a row, which is what makes the
/// customer tracking timeline and any later dispute investigation possible.
model StatusHistory {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus
  note   String?

  /// Null when the change came from automation or from a rider link rather
  /// than a signed-in admin. changedByName is denormalised so the timeline
  /// still reads correctly if the admin account is later removed.
  changedByAdminId String?
  changedByAdmin   AdminUser? @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  changedByName    String?

  changedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId, changedAt])
  @@map("status_history")
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

/// Single-row table holding the live price list. The id is pinned to 1 with a
/// check constraint in the migration, so a second row cannot be created.
model PricingConfig {
  id Int @id @default(1)

  /// One flat rate covers a parcel up to includedKg, to any town we serve.
  /// Weight above that is charged per whole kilo. All in integer pesewas.
  baseAmount       Int @default(5000)
  includedKg       Int @default(3)
  perExtraKgAmount Int @default(1000)

  currency  String   @default("GHS") @db.VarChar(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("pricing_config")
}

/// What a notification is about. The message text is built when the row is
/// written, so a later copy change cannot rewrite what a customer was already
/// told.
enum NotificationEvent {
  booking_confirmed
  /// Retired: folded into booking_confirmed, which now says payment was
  /// received when it has been. Kept so rows written before that still read.
  payment_received
  /// Weighing changed the price. Only queued when it actually changed.
  price_confirmed
  rider_assigned
  out_for_delivery
  delivered
  /// Silence when a parcel is cancelled is the worst gap in the outbox.
  cancelled
}

enum NotificationStatus {
  pending
  sent
  failed
}

/// Outbox for customer notifications.
///
/// Nothing sends yet — there is no SMS provider wired up. Rows accumulate here
/// so the trigger points are settled and auditable, and so sending can be added
/// later without touching the code that decides *when* to notify.
///
/// Deliberately a table rather than an inline send: an SMS outage must never
/// fail a customer's booking, and a queue can be retried and inspected.
model Notification {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  event     NotificationEvent
  /// Phone number as captured on the order at the time of the event.
  recipient String
  /// Rendered at write time, not at send time.
  message   String

  status   NotificationStatus @default(pending)
  attempts Int                @default(0)
  /// When the worker may try again after a failure. Null means "as soon as
  /// possible" for a pending row, and nothing at all for a settled one.
  nextAttemptAt DateTime? @db.Timestamptz(3)
  /// Provider message id once sending exists; also the idempotency handle.
  providerReference String?
  lastError         String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)

  /// One notification per order per event — a retried automation pass or a
  /// double-tapped button must not text the customer twice.
  @@unique([orderId, event])
  @@index([status, createdAt])
  /// The worker's own query: pending rows that are due.
  @@index([status, nextAttemptAt])
  @@map("notifications")
}
