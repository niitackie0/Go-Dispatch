# GO DISPATCH — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real value here.
#
#     cp .env.example .env

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------

# Pooled connection, used by the app at runtime. Ends with `-pooler` in the host.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct connection, used by `prisma migrate` — DDL and advisory locks do not
# survive a connection pooler. Same credentials, host without `-pooler`.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Console
# ---------------------------------------------------------------------------

# Where the operations console is served. It is protected by a password, not
# by its address, but /admin is the first thing any scanner tries.
ADMIN_PATH=/ops

# ---------------------------------------------------------------------------
# SMS — see docs/sms-messages.md
# ---------------------------------------------------------------------------

# THE SWITCH. Empty means messages queue up and nothing is sent. Set to
# `arkesel` to start sending — including everything already queued, so run
# `npm run sms:outbox` first to see what that is.
SMS_PROVIDER=

# Arkesel API key, from their dashboard.
SMS_API_KEY=

# Must be registered with the provider. 11 characters is the GSM maximum, and
# "GO DISPATCH" is exactly 11. Until it is approved, messages arrive from a
# shortcode and each one spends 13 characters saying who it is from.
SMS_SENDER_ID=GO DISPATCH

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# `production` serves the built bundle from dist/ instead of running Vite.
NODE_ENV=development
