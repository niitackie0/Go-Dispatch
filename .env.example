# GO DISPATCH — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real value here.
#
#     cp .env.example .env

# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------

# Pooled connection, used by the app at runtime. Ends with `-pooler` in the host.
#
# NOTE THE sslmode. Neon hands you `require`, and `pg` currently treats that as
# `verify-full` -- the certificate is actually checked. In the next major it
# adopts libpq's meaning instead: encrypt, but accept whatever certificate is
# offered. That downgrade would arrive silently, on an upgrade, with nothing in
# the log. Writing verify-full pins today's behaviour to the name it deserves.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Direct connection, used by `prisma migrate` — DDL and advisory locks do not
# survive a connection pooler. Same credentials, host without `-pooler`.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full

# ---------------------------------------------------------------------------
# Console
# ---------------------------------------------------------------------------

# Where the operations console is served. It is protected by a password, not
# by its address, but /admin is the first thing any scanner tries.
ADMIN_PATH=/ops

# ---------------------------------------------------------------------------
# SMS — see docs/sms-messages.md
# ---------------------------------------------------------------------------

# THE SWITCH. Empty means messages queue up and nothing is sent. Set to
# `arkesel` to start sending — including everything already queued, so run
# `npm run sms:outbox` first to see what that is.
SMS_PROVIDER=

# Arkesel API key, from their dashboard.
SMS_API_KEY=

# Must be registered with the provider. 11 characters is the GSM maximum, and
# "GO DISPATCH" is exactly 11. Until it is approved, messages arrive from a
# shortcode and each one spends 13 characters saying who it is from.
SMS_SENDER_ID=GO DISPATCH

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# `production` serves the built bundle from dist/ instead of running Vite.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Errors and monitoring
# ---------------------------------------------------------------------------

# Where errors go so somebody hears about them. Any free Slack or Discord
# incoming webhook works. Unset, errors are logged and nothing else -- which
# means nobody sees them, because nobody reads a deployed process's stdout.
#
# One message per distinct error per ten minutes, so a crash loop cannot bury
# the first one or get the webhook rate-limited into silence.
ERROR_WEBHOOK_URL=

# Queries slower than this log themselves with the query attached. Default 400.
SLOW_QUERY_MS=
